@* PAGINA DE ERROR GLOBAL
   Se muestra cuando ocurre una excepcion no controlada en la aplicacion.
   Configurada en Program.cs: app.UseExceptionHandler("/Error")
   Muestra un mensaje amigable y enlaces para volver al inicio.
*@
@page "/Error"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Error - Gestión Académica</PageTitle>

<div class="page-header d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size:2rem"></i>
    <h1 class="mb-0 text-danger">Error</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-bug text-danger" style="font-size:4rem"></i>
        <h2 class="fw-bold mt-3">Ha ocurrido un error</h2>
        <p class="text-muted">Se ha producido un error inesperado en la aplicación.</p>
        <p class="text-muted">Puedes volver al inicio e intentarlo de nuevo.</p>
        <a href="/" class="btn btn-primary btn-icon mt-3">
            <i class="bi bi-house-door"></i> Volver al inicio
        </a>
    </div>
</div>
