<Window x:Class="Pokedex.Views.Dialog.EstadisticasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Estadísticas Pokedex" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1a1a2e"
        Icon="/Resources/app-icon.ico">

    <DockPanel>
        <!-- Cabecera -->
        <Border DockPanel.Dock="Top" Background="#cc0000" Padding="15,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="🔄 Reset Zoom" Click="ResetZoom_Click"
                        Background="#FFCB05" Foreground="#16213e" FontWeight="Bold" Padding="10,5"
                        BorderThickness="0" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/icons/about.png" Width="28" Height="28" Margin="0,0,12,0"/>
                    <TextBlock Text="ESTADÍSTICAS POKÉDEX" FontSize="20" FontWeight="Bold"
                               Foreground="#FFCB05" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="  |  Rueda: Zoom | Click derecho: Seleccionar área | Reset: Doble click"
                               FontSize="11" Foreground="#FFCB05" VerticalAlignment="Center" Margin="30,0,0,0" Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grid de gráficas 2x2 -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="#16213e" BorderBrush="#3B82C4" BorderThickness="2" CornerRadius="8" Margin="4">
                <Grid>
                    <TextBlock Text="Top 10 Tipos" Foreground="#FFCB05" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <lvc:CartesianChart x:Name="TiposChart" Margin="0,40,10,10"
                                         ZoomMode="X"/>
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Background="#16213e" BorderBrush="#3B82C4" BorderThickness="2" CornerRadius="8" Margin="4">
                <Grid>
                    <TextBlock Text="Pokemons por Generación" Foreground="#FFCB05" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <lvc:CartesianChart x:Name="GeneracionesChart" Margin="0,40,10,10"
                                         ZoomMode="X"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Background="#16213e" BorderBrush="#3B82C4" BorderThickness="2" CornerRadius="8" Margin="4">
                <Grid>
                    <TextBlock Text="Top 10 por Stats Totales" Foreground="#FFCB05" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <lvc:CartesianChart x:Name="PokemonStatsChart" Margin="0,40,10,10"
                                         ZoomMode="X"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="#16213e" BorderBrush="#3B82C4" BorderThickness="2" CornerRadius="8" Margin="4">
                <Grid>
                    <TextBlock Text="Categoría Especial" Foreground="#FFCB05" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    <lvc:PieChart x:Name="LegendariosChart" Margin="0,40,10,10"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>